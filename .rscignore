# Files the running Shiny app does not need -- keeps the shinyapps.io bundle
# lean and keeps publication figures off the public server.
#
# NOTE: rsconnect's .rscignore matches EXACT file/directory names only --
# wildcards (e.g. *.tiff) are NOT supported. A directory name excludes the
# whole directory, which is why all publication figures now live in figures/.

# publication figure outputs (all of them)
figures

# figure-generation driver and dev-/manuscript-only files
make_pub_plots.R
renv.lock.archive
README.md
RNAStudy_for_Publication.Rproj
